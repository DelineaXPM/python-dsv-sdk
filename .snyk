# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
# Snyk's SCM import tests pip projects with Python 3.7 unless told otherwise. Under 3.7 it cannot
# install the pins in requirements.txt (urllib3 >= 2.7 needs Python >= 3.10) and reports the last
# 3.7-compatible versions instead (urllib3 2.0.7, requests 2.31.0, zipp 3.15.0). 3.11 is the top of
# the CI test matrix. This affects Snyk's scan of requirements.txt only, not requires-python.
version: v1.25.0
ignore: {}
patch: {}
language-settings:
  python: '3.11'
